  "features": {
    "privateFilter": {
      "rule": {
        "qb": {
          "gte": "5.0.0"
        }
      },
      "sourceRequired": true,
      "upstream": {
        "torrentInfoField": "private"
      },
      "presentation": {
        "unsupported": "hide",
        "badge": "auto",
        "requirements": {
          "qb": "5.0.0",
          "webApi": "2.11.2",
          "knownQb": "5.0.0"
        }
      },
      "copy": {
        "title": {
          "en": "Private / PT"
        },
        "reason": {
          "en": "Shown in the Tracker facet only when the selected qBittorrent release exposes authoritative Private metadata.",
          "zh": "只有当前 qBittorrent 稳定版明确返回权威 Private 元数据时，Tracker 筛选中才显示 Private / PT。"
        }
      }
    },
    "categoryFacet": {
      "rule": {
        "all": [
          {
            "qb": {
              "gte": "4.1.4"
            }
          },
          {
            "webApi": {
              "gte": "2.1.1"
            }
          }
        ]
      },
      "sourceRequired": true,
      "upstream": {
        "torrentInfoField": "category"
      },
      "selectors": [
        "[data-facet=\"category\"]"
      ],
      "presentation": {
        "unsupported": "hide",
        "badge": "auto"
      },
      "copy": {
        "title": {
          "en": "Categories",
          "zh": "分类"
        },
        "reason": {
          "en": "Category filtering requires a source-proven Torrent category field.",
          "zh": "分类筛选需要上游源码明确返回 Torrent category 字段。"
        }
      }
    },
